# 应用配置 - 生产环境
APP_NAME=摄影师服务平台
APP_ENV=production
APP_PORT=8000
APP_URL=https://api.photoplatform.com

# 数据库配置
DB_TYPE=postgres
DB_HOST=postgres-production
DB_PORT=5432
DB_USERNAME=prod_user
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
DB_DATABASE=photo_platform_prod
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_SSL=true

# Redis配置
REDIS_HOST=redis-production
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD
REDIS_DB=0

# JWT配置 - 必须使用强密码
JWT_SECRET=CHANGE_THIS_TO_A_VERY_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRATION=7d
JWT_REFRESH_EXPIRATION=30d

# 文件上传配置
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp
UPLOAD_PATH=/var/uploads

# 云存储配置 - 生产环境使用云存储
# 阿里云OSS
ALIYUN_OSS_REGION=oss-cn-hangzhou
ALIYUN_OSS_ACCESS_KEY_ID=CHANGE_THIS
ALIYUN_OSS_ACCESS_KEY_SECRET=CHANGE_THIS
ALIYUN_OSS_BUCKET=photo-platform-production

# 地图服务配置
AMAP_KEY=CHANGE_THIS_AMAP_KEY
AMAP_SECRET=CHANGE_THIS_AMAP_SECRET

# 支付服务配置
# 支付宝
ALIPAY_APP_ID=CHANGE_THIS
ALIPAY_PRIVATE_KEY=CHANGE_THIS
ALIPAY_PUBLIC_KEY=CHANGE_THIS
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# 微信支付
WECHAT_APP_ID=CHANGE_THIS
WECHAT_MCH_ID=CHANGE_THIS
WECHAT_API_KEY=CHANGE_THIS
WECHAT_APICLIENT_CERT=/path/to/cert.pem
WECHAT_APICLIENT_KEY=/path/to/key.pem

# 短信服务配置
SMS_PROVIDER=aliyun
SMS_ACCESS_KEY_ID=CHANGE_THIS
SMS_ACCESS_KEY_SECRET=CHANGE_THIS
SMS_SIGN_NAME=摄影师平台
SMS_TEMPLATE_CODE=SMS_12345678

# 邮件服务配置
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@photoplatform.com
SMTP_PASSWORD=CHANGE_THIS
SMTP_FROM=摄影师平台 <noreply@photoplatform.com>

# AI服务配置
AI_SERVICE_URL=http://ai-service:8001
AI_SERVICE_TIMEOUT=30000

# 消息队列配置
RABBITMQ_HOST=rabbitmq-production
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=prod_user
RABBITMQ_PASSWORD=CHANGE_THIS_RABBITMQ_PASSWORD

# 日志配置
LOG_LEVEL=info
LOG_FILE_PATH=/var/log/photo-platform

# CORS配置
CORS_ENABLED=true
CORS_ORIGINS=https://photoplatform.com,https://www.photoplatform.com

# 限流配置
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# 文件上传限流
UPLOAD_RATE_LIMIT_TTL=60
UPLOAD_RATE_LIMIT_MAX=10

# 前端配置
WEB_URL=https://photoplatform.com
NEXT_PUBLIC_API_URL=https://api.photoplatform.com/api/v1

# 监控配置
SENTRY_DSN=CHANGE_THIS_SENTRY_DSN
SENTRY_ENVIRONMENT=production

# 数据统计
BaiduAnalyticsID=CHANGE_THIS
GoogleAnalyticsID=CHANGE_THIS

# CDN配置
CDN_URL=https://cdn.photoplatform.com

# 备份配置
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
